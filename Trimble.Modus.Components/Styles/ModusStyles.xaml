          <VisualState x:Name="Off">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{DynamicResource SwitchOffBackgroundColor}"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>


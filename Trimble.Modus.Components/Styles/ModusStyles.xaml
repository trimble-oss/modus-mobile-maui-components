  <!--Control Label Styles-->
  <Style TargetType="local:ControlLabel"
       x:Key="DefaultControlLabelStyle">
    <Setter Property="HeaderTextColor"
          Value="{DynamicResource ControlLabelTextColor}" />
  </Style>

  <!--TMDropdown Styles-->
  <Style TargetType="local:TMDropDown"
       x:Key="DefaultStyle">
    <Setter Property="BackgroundColor"
          Value="{DynamicResource DropDownBackgroundColor}" />
    <Setter Property="BorderColor"
          Value="{DynamicResource DropDownBorderColor}" />
    <Setter Property="TextAndIconColor"
          Value="{DynamicResource DropDownTextAndIconColor}" />
  </Style>

  <Style TargetType="local:DropDownContents"
       x:Key="DefaulDropDownContentstStyle">
    <Setter Property="BorderColor"
          Value="{DynamicResource DropDownContentBorderColor}" />
  </Style>

  <!--TMButton Styles-->
  <Style TargetType="local:TMButton" x:Key="PrimaryFill">
    <Setter Property="TextColor" Value="{DynamicResource PrimaryFillButtonTextColor}"></Setter>
    <Setter Property="IconTintColor" Value="{DynamicResource PrimaryFillIconTintColor}"></Setter>
    <Setter Property="BorderColor" Value="{DynamicResource PrimaryFillButtonBackgroundColor}"/>
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFillButtonBackgroundColor}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFillButtonSelectedBackgroundColor}"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

